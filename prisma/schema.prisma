// Gestor Comercial — mini ERP (projeto proprio).
// Campos de Pedido e Nota Fiscal seguem os nomes da API publica v2 do Tiny/Olist
// (documentacao publica). Ordem de Servico e modelo proprio, no padrao de ERPs de
// assistencia, pois a API publica nao expoe esse recurso.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  nomeFantasia String?
  tipoPessoa   String   @default("F") // F | J | E
  cpfCnpj      String?
  ie           String?
  email        String?
  fone         String?
  endereco     String?
  numero       String?
  complemento  String?
  bairro       String?
  cep          String?
  cidade       String?
  uf           String?
  papel        String   @default("cliente") // cliente | fornecedor | transportador | outro

  pedidos      Pedido[]
  ordens       OrdemServico[]
  notas        NotaFiscal[]
  criadoEm     DateTime @default(now())
}

model Pedido {
  id               Int      @id @default(autoincrement())
  numero           Int      @unique
  numeroEcommerce  String?
  dataPedido       DateTime @default(now())
  dataPrevista     DateTime?
  situacao         String   @default("Em aberto")
  clienteId        Int
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  valorFrete       Float    @default(0)
  valorDesconto    Float    @default(0)
  outrasDespesas   Float    @default(0)
  totalProdutos    Float    @default(0)
  totalPedido      Float    @default(0)
  condicaoPagamento String?
  formaFrete       String?
  fretePorConta    String   @default("R") // R D T 3 4 S
  formaEnvio       String?
  codigoRastreamento String?
  vendedor         String?
  obs              String?
  obsInterna       String?
  pesoBruto        Float    @default(0)
  pesoLiquido      Float    @default(0)
  termoId          Int?
  termo            TermoGarantia? @relation(fields: [termoId], references: [id])
  itens            PedidoItem[]
  notaId           Int?
  criadoEm         DateTime @default(now())
}

model PedidoItem {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  codigo        String?
  descricao     String
  unidade       String  @default("UN")
  quantidade    Float   @default(1)
  valorUnitario Float   @default(0)
}

model OrdemServico {
  id              Int      @id @default(autoincrement())
  numero          Int      @unique
  dataAbertura    DateTime @default(now())
  dataPrevista    DateTime?
  dataConclusao   DateTime?
  situacao        String   @default("Aberta")
  clienteId       Int
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  equipamento     String?
  numeroSerie     String?
  defeitoRelatado String?
  diagnostico     String?
  solucao         String?
  tecnico         String?
  valorServicos   Float    @default(0)
  valorPecas      Float    @default(0)
  valorTotal      Float    @default(0)
  obs             String?
  tipo            String   @default("reparo") // reparo | upgrade
  serialNovo      String?
  usadoRecebido   String?
  avaliacaoUsado  Float    @default(0)
  valorNovo       Float    @default(0)
  termoId         Int?
  termo           TermoGarantia? @relation(fields: [termoId], references: [id])
  itens           OrdemServicoItem[]
  criadoEm        DateTime @default(now())
}

model OrdemServicoItem {
  id            Int          @id @default(autoincrement())
  ordemId       Int
  ordem         OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  tipo          String       @default("servico") // servico | peca
  descricao     String
  quantidade    Float        @default(1)
  valorUnitario Float        @default(0)
}

model NotaFiscal {
  id               Int      @id @default(autoincrement())
  tipoNota         String   @default("S") // E | S
  naturezaOperacao String?
  serie            Int      @default(1)
  numero           Int      @unique
  dataEmissao      DateTime @default(now())
  dataSaida        DateTime?
  clienteId        Int
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  valorProdutos    Float    @default(0)
  valorServicos    Float    @default(0)
  valorFrete       Float    @default(0)
  valorIcms        Float    @default(0)
  valorDesconto    Float    @default(0)
  valorNota        Float    @default(0)
  fretePorConta    String   @default("R")
  pesoBruto        Float    @default(0)
  pesoLiquido      Float    @default(0)
  situacao         Int      @default(1) // 1 Pendente ...
  descricaoSituacao String  @default("Pendente")
  chaveAcesso      String?
  idVenda          Int?
  vendedor         String?
  obs              String?
  itens            NotaFiscalItem[]
  criadoEm         DateTime @default(now())
}

model NotaFiscalItem {
  id            Int        @id @default(autoincrement())
  notaId        Int
  nota          NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  codigo        String?
  descricao     String
  unidade       String     @default("UN")
  ncm           String?
  cfop          String?
  quantidade    Float      @default(1)
  valorUnitario Float      @default(0)
  valorTotal    Float      @default(0)
}

model HistoricoSituacao {
  id         Int      @id @default(autoincrement())
  entidade   String   // "pedido" | "ordem" | "nota"
  entidadeId Int
  de         String?
  para       String
  observacao String?
  autor      String?
  criadoEm   DateTime @default(now())

  @@index([entidade, entidadeId])
}

model TermoGarantia {
  id       Int      @id @default(autoincrement())
  nome     String
  conteudo String
  criadoEm DateTime @default(now())

  pedidos  Pedido[]
  ordens   OrdemServico[]
}

model Empresa {
  id       Int     @id @default(autoincrement())
  nome     String
  cnpj     String?
  ie       String?
  endereco String?
  cidade   String?
  uf       String?
  cep      String?
  telefone String?
  site     String?
}

model Produto {
  id            Int     @id @default(autoincrement())
  descricao     String
  sku           String?
  gtin          String?
  ncm           String?
  tipo          String  @default("simples") // simples | kit | variacao | fabricado | materia-prima
  categoria     String?
  preco         Float   @default(0)
  custo         Float   @default(0)
  estoque       Float   @default(0)
  situacao      String  @default("ativo") // ativo | inativo
  criadoEm      DateTime @default(now())
}

model Vendedor {
  id          Int     @id @default(autoincrement())
  nome        String
  email       String?
  comissaoPct Float   @default(0)
  situacao    String  @default("ativo")
  criadoEm    DateTime @default(now())
}

model Garantia {
  id           Int      @id @default(autoincrement())
  protocolo    String   @unique
  serial       String?
  modelo       String?
  clienteNome  String
  cpf          String?
  problema     String?
  status       String   @default("Aberta") // Aberta | Em analise | Aguardando peca | Resolvida | Negada
  dataAbertura DateTime @default(now())
  obs          String?
  criadoEm     DateTime @default(now())
}
